<?xml version="1.0"?>
<package format="3">
  <name>cloud_pipeline</name>
  <version>0.0.1</version>

  <description>
    Point cloud accumulation, filtering, normal estimation,
    segmentation, cylinder fitting, and clicked-target selection
    for the APhI drone contact-point pipeline.
  </description>

  <maintainer email="ttn32@cam.ac.uk">tin</maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 -->
  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
  <depend>yaml-cpp</depend>

  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- OptiTrack bridge (mocap2ros2/optitrack_packages_ros2) -->
  <depend>optitrack_multiplexer_ros2_msgs</depend>

  <!-- TF2 -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Point cloud -->
  <depend>pcl_conversions</depend>

  <!-- Eigen -->
  <depend>eigen</depend>

  <depend>libpcl-all-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
